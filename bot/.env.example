# Discord Bot Token — Create one at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Required: Channel ID where the bot posts all tournament announcements
ANNOUNCE_CHANNEL_ID=0

# Required: Your Discord User ID (bot owner) — only you can use admin commands
BOT_OWNER_ID=0

# Optional: DeepSeek API Key for AI-powered hype/commentary + /cup_edit
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
